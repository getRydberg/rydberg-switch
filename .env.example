# Web dashboard
SWITCH_HOST=switch.rydberg.app
GAME_PUBLIC_HOST=play.rydberg.app
SWITCH_ACCESS_KEY=replace-with-a-long-random-shared-key
SECURE_COOKIES=true

# Rydberg / host
RYDBERG_NETWORK=rydberg-net
GAME_BIND_IP=0.0.0.0
PUID=1000
PGID=1000
TZ=America/Los_Angeles

# Accept Mojang's Minecraft EULA before changing this to TRUE:
# https://aka.ms/MinecraftEULA
MINECRAFT_EULA=FALSE

# Private game credentials (do not commit the .env file)
PALWORLD_SERVER_PASSWORD=change-me
PALWORLD_ADMIN_PASSWORD=change-me-admin
ARK_SERVER_PASSWORD=change-me
ARK_ADMIN_PASSWORD=change-me-admin

